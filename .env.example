# Copy this file to .env and fill in real values. Never commit .env

DATABASE_URL=postgresql+psycopg://docapp:docapp_pass@postgres:5432/docapp_db
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

JWT_SECRET_KEY=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# AI/OCR provider - used for document understanding + extraction
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.0-flash
# Gemini free-tier quotas vary by model and account; expect request-per-minute limits.
# Alternative if you prefer OpenAI vision instead:
# OPENAI_API_KEY=your_key_here

MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png
STORAGE_DIR=/code/storage
